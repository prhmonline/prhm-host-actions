[Unit]
Description=PRHM Solo Multi-Site Public Smoke QA (read-only)
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=prhm-sites-smoke
StateDirectoryMode=0700
Environment=SOLO_SMOKE_STATE_DIR=/var/lib/prhm-sites-smoke
ExecStart=/usr/local/bin/prhm-node /opt/prhm-sites-smoke/smoke.mjs --once
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=80
MemoryMax=128M
CPUQuota=25%
