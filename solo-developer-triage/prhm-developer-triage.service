[Unit]
Description=PRHM Solo Developer Triage Agent (QA evidence only, no source writes)
After=local-fs.target
ConditionPathExists=/opt/prhm-developer-triage/collect.mjs

[Service]
Type=oneshot
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
StateDirectory=prhm-developer-triage
StateDirectoryMode=0700
Environment=SOLO_DEVELOPER_STATE_DIR=/var/lib/prhm-developer-triage
ExecStart=/usr/local/bin/prhm-node /opt/prhm-developer-triage/pipeline.mjs --once
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=45
MemoryMax=128M
CPUQuota=20%
